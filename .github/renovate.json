{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "separateMinorPatch": true,
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Only allow patch-level Go toolchain updates",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "golang",
        "go"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "golang",
        "go"
      ],
      "separateMinorPatch": true,
      "groupName": null
    },
    {
      "description": "Do not update Dockerfiles for release-6.5 and lower image paths",
      "matchFileNames": [
        "dockerfiles/bases/**/release-6.5.Dockerfile",
        "dockerfiles/products/**/~6.5.12/**",
        "dockerfiles/products/**/lt6.5.12/**"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "labels": [
        "help wanted"
      ]
    },
    {
      "description": "Auto PR for cd builder images; ignore vYYYYMMDD-*; suffix kept via regex manager",
      "matchDatasources": [
        "docker"
      ],
      "allowedVersions": "!/^v\\d{8}-/",
      "prCreation": "immediate",
      "matchDepNames": [
        "/^ghcr\\.io/pingcap-qe/cd//"
      ]
    },
    {
      "description": "The tiflash wrapper pin does not need a PR per weekly artifacts release",
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepNames": [
        "PingCAP-QE/artifacts"
      ],
      "groupName": "artifacts release pin",
      "schedule": [
        "before 5am on the first day of the month"
      ]
    },
    {
      "description": "Base images are tagged with a semver-compatible tag converted from git describe (e.g. v2026.11.27-2.ge5c763a). The date-based major counts as a regular refresh and the distance/sha parses as a prerelease, so re-enable major updates and allow prereleases, grouped in one PR.",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "/^ghcr\\.io/pingcap-qe/bases//"
      ],
      "enabled": true,
      "ignoreUnstable": false,
      "groupName": "pingcap base images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.(yml|yaml)$$/",
        "/.*\\.Dockerfile$$/",
        "/.*/Dockerfile$$/"
      ],
      "matchStrings": [
        "datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*(version|VERSION|ver|VER)(: |=)(?<currentValue>.*)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*/packages.yaml.tmpl$$/"
      ],
      "matchStrings": [
        "\\bimage: (?<depName>ghcr.io/pingcap-qe/cd/.*?):(?<currentValue>(?<gitprefix>v[0-9][0-9.]*-[0-9]+-g[0-9a-f]+)-(?<suffix>[^\\s]+))"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?-(?<build>\\d+)-g[0-9a-f]+(?:-(?<compatibility>.+))?$",
      "autoReplaceStringTemplate": "image: {{depName}}:{{newValue}}"
    },
    {
      "customType": "regex",
      "description": "The tiflash wrapper is downloaded inside the tiflash build step, so it cannot be a repo-relative path; track the weekly date releases of this repository",
      "managerFilePatterns": [
        "/.*/packages.yaml.tmpl$$/"
      ],
      "matchStrings": [
        "https://cdn\\.jsdelivr\\.net/gh/PingCAP-QE/artifacts@(?<currentValue>v[0-9]{4}\\.[0-9]{1,2}\\.[0-9]{1,2})/dockerfiles/products/tiflash/tiflash-wrapper"
      ],
      "depNameTemplate": "PingCAP-QE/artifacts",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^v(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})$"
    }
  ]
}
